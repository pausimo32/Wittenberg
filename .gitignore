# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# ── Node / frontend ──────────────────────────────────────────────────────
node_modules/
web/dist/
web/node_modules/
.vite/

# ── Local configuration ──────────────────────────────────────────────────
# `.env.example` stays versioned; `.env` never does.
.env
.env.*
!.env.example

# ── Model artefacts ──────────────────────────────────────────────────────
# Weights are never versioned. `python tasks.py check-model` verifies a
# checkpoint against config/preprocess.json; the checkpoint itself is local.
*.pt
*.pth
*.onnx
*.keras
*.h5
*.tflite

# ── Datasets ─────────────────────────────────────────────────────────────
# Captures and derived images are never versioned; the metadata, the mode
# table, the per-session calibrations and the ingest report are — they are
# what makes a run reproducible. See CLAUDE.md rule 4, docs/02-dataset-spec.md.
data/raw/
data/processed/
!data/metadata.csv

# ── Training runs ────────────────────────────────────────────────────────
# Everything in runs/ is ignored except metrics.json and config.json, which
# are the reportable trace of a run. The two-step pattern below is required:
# git does not descend into an excluded directory, so `runs/*` + `!runs/*/`
# re-opens the run directories before their contents are filtered.
runs/*
!runs/*/
runs/*/*
!runs/*/metrics.json
!runs/*/config.json

# ── Scratch ──────────────────────────────────────────────────────────────
scratchpad/
rapport_validation.json

# ── Misc ─────────────────────────────────────────────────────────────────
# AppleDouble files created by macOS on non-HFS volumes.
._*
.DS_Store
Thumbs.db
*.log
