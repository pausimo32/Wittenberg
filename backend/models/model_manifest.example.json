{
  "manifest_version": 1,
  "model": {
    "name": "wittenberg-chladni-cnn",
    "version": "0.0.0-exemple",
    "framework": "onnx",
    "format": "onnx",
    "artifact": "chladni_cnn.onnx",
    "sha256": null,
    "trained_at": null,
