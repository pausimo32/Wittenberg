# Wittenberg — configuration du service d'inférence
#
# Copiez ce fichier en `.env` dans le dossier `backend/` et adaptez les valeurs.
# Ce fichier ne doit contenir AUCUN secret : le service n'en utilise pas.
# Toutes les variables portent le préfixe WITTENBERG_.

# ── Modèle ───────────────────────────────────────────────────────────────
# Manifeste décrivant le modèle, son prétraitement et l'ordre exact des
# classes. Sans lui, le service démarre mais /ready répond 503.
# Chemin absolu, ou relatif au dossier `backend/`.
WITTENBERG_MODEL_MANIFEST_PATH=models/model_manifest.json

# Artefact du modèle. Facultatif : par défaut, le fichier désigné par le champ
# `model.artifact` du manifeste, résolu depuis le dossier du manifeste.
# WITTENBERG_MODEL_PATH=models/chladni_cnn.onnx

# Vérifier le SHA-256 déclaré dans le manifeste au démarrage.
WITTENBERG_VERIFY_MODEL_HASH=true

# Inférence de préchauffage au démarrage. Valide aussi le nombre réel de sorties.
WITTENBERG_WARMUP_ON_STARTUP=true

# En production, mettre à true : le service refuse alors de démarrer sans
# modèle valide, au lieu de rester joignable en état non disponible.
WITTENBERG_STRICT_STARTUP=false

# ── Limites d'entrée ─────────────────────────────────────────────────────
WITTENBERG_MAX_UPLOAD_MB=10
WITTENBERG_MAX_IMAGE_PIXELS=40000000
WITTENBERG_MAX_IMAGE_DIMENSION=12000
WITTENBERG_MIN_IMAGE_DIMENSION=32

# ── Inférence ────────────────────────────────────────────────────────────
WITTENBERG_INFERENCE_TIMEOUT_MS=15000
WITTENBERG_TOP_K=3
# Fils d'exécution ONNX Runtime par inférence. 1 convient à un service web,
# où le parallélisme vient des requêtes simultanées.
WITTENBERG_ONNX_INTRA_OP_THREADS=1

# ── HTTP ─────────────────────────────────────────────────────────────────
# Liste explicite d'origines autorisées, séparées par des virgules.
# N'utilisez JAMAIS « * » : la valeur serait ignorée.
WITTENBERG_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080
WITTENBERG_API_PREFIX=/api/v1

# ── Observabilité ────────────────────────────────────────────────────────
WITTENBERG_LOG_LEVEL=INFO

# Renvoie l'image prétraitée en base64 dans la réponse. Développement seulement :
# la réponse contient alors une image, ce qui alourdit et expose le contenu.
WITTENBERG_ENABLE_DEBUG_PREVIEW=false
